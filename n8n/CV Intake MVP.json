    {
      "parameters": {
        "jsCode": "const form = $('CV Upload Form').first();\nconst raw = $json.output ?? $json;\n\nlet profile = raw;\nif (typeof raw === 'string') {\n  try { profile = JSON.parse(raw); }\n  catch (error) { throw new Error(`El perfil extraído no es JSON válido: ${error.message}`); }\n}\n\nconst formJson = form.json ?? {};\nconst file =\n    form.binary?.Adjunta_tu_CV_en_PDF ??\n    form.binary?.cv_file ??\n    {};\n\nreturn [{ json: {\n  candidate_id: `accounting-${Date.now()}`,\n  uploaded_at: new Date().toISOString(),\n  full_name: formJson.full_name ?? formJson['Nombre completo'] ?? '',\n  email: formJson.email ?? formJson['Correo electrónico'] ?? '',\n  cv_filename: file.fileName ?? '',\n  cv_profile_json: JSON.stringify(profile),\n  status: 'ready_for_interview',\n  interview_url: 'https://mariaelena1988.app.n8n.cloud/webhook/accounting-career-profile-chat/chat'\n}}];"
      },
