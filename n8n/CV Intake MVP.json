      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"additionalProperties\": false,\n  \"required\": [\n    \"professional_identity\",\n    \"experience\",\n    \"accounting_areas\",\n    \"tools\",\n    \"skills\",\n    \"education\",\n    \"certifications\",\n    \"languages\",\n    \"information_to_confirm\"\n  ],\n  \"properties\": {\n    \"professional_identity\": {\n      \"type\": \"object\",\n      \"additionalProperties\": false,\n      \"required\": [\n        \"most_recent_role\",\n        \"years_of_experience\",\n        \"professional_summary\"\n      ],\n      \"properties\": {\n        \"most_recent_role\": {\n          \"type\": \"string\"\n        },\n        \"years_of_experience\": {\n          \"type\": \"string\"\n        },\n        \"professional_summary\": {\n          \"type\": \"string\"\n        }\n      }\n    },\n    \"experience\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"additionalProperties\": false,\n        \"required\": [\n          \"job_title\",\n          \"company\",\n          \"start_date\",\n          \"end_date\",\n          \"responsibilities\",\n          \"explicit_achievements\"\n        ],\n        \"properties\": {\n          \"job_title\": {\n            \"type\": \"string\"\n          },\n          \"company\": {\n            \"type\": \"string\"\n          },\n          \"start_date\": {\n            \"type\": \"string\"\n          },\n          \"end_date\": {\n            \"type\": \"string\"\n          },\n          \"responsibilities\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"string\"\n            }\n          },\n          \"explicit_achievements\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"string\"\n            }\n          }\n        }\n      }\n    },\n    \"accounting_areas\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      }\n    },\n    \"tools\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      }\n    },\n    \"skills\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      }\n    },\n    \"education\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"additionalProperties\": false,\n        \"required\": [\n          \"degree\",\n          \"institution\",\n          \"year\"\n        ],\n        \"properties\": {\n          \"degree\": {\n            \"type\": \"string\"\n          },\n          \"institution\": {\n            \"type\": \"string\"\n          },\n          \"year\": {\n            \"type\": \"string\"\n          }\n        }\n      }\n    },\n    \"certifications\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      }\n    },\n    \"languages\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      }\n    },\n    \"information_to_confirm\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      }\n    }\n  }\n}"
      },
      "id": "d3dd147e-b43e-4c97-8748-75e1f4c97012",
